# ─── Identidade do agente ────────────────────────────────────
# Troque para usar este projeto com outro foco (ex.: bot de promoções). Também preenche
# os marcadores {{AGENT_NAME}}, {{OWNER_NAME}}, {{AGENT_PURPOSE}}... dentro dos SKILL.md.
AGENT_NAME=AgroMinds
AGENT_EMOJI=🦀
OWNER_NAME=Agro
AGENT_PURPOSE=agente pessoal de IA
# Instruções extras de foco/estilo (para quebrar linha, escreva \n). Ex.: Foco em promoções de tecnologia.
AGENT_INSTRUCTIONS=
AGENT_LANGUAGE=português do Brasil

# ─── Telegram ────────────────────────────────────────────────
# Token do bot gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
# IDs numéricos autorizados (separados por vírgula). Descubra o seu com o @userinfobot
TELEGRAM_ALLOWED_USER_IDS=123456789

# ─── LLM ─────────────────────────────────────────────────────
# Provider principal: gemini | deepseek | groq | ollama
LLM_PROVIDER=gemini
# Providers de fallback, em ordem (opcional). Ex.: deepseek,groq
LLM_FALLBACK_PROVIDERS=ollama
# Provider usado pelo SkillRouter (passo zero, barato). Vazio = mesmo do principal
SKILL_ROUTER_PROVIDER=
# Timeout por chamada ao LLM (ms)
LLM_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.4

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Raciocínio do Gemini 3: low (rápido, ~3s) | medium | high (padrão do Google, ~25s) | vazio = padrão
GEMINI_REASONING_EFFORT=low
# Limite por chamada ao Gemini; ao estourar, o fallback (LLM_FALLBACK_PROVIDERS) assume
GEMINI_TIMEOUT_MS=60000

# ─── Orquestrador de LLMs gratuitos (spec llm-orchestration) ──
# on: escolhe automaticamente o melhor modelo GRATUITO por tarefa (inclui os da sua GPU via Ollama
#     quando forem melhores); off: usa a cadeia fixa LLM_PROVIDER → LLM_FALLBACK_PROVIDERS.
LLM_ORCHESTRATOR=off
# Única política suportada: nenhum modelo pago é chamado.
LLM_COST_POLICY=free-only
# Fontes permitidas (só as com chave/instaladas entram): opencode,openrouter,nvidia,gemini,groq,ollama,ollama-cloud
FREE_SOURCES=opencode,openrouter,nvidia,gemini,groq,ollama,ollama-cloud
# OpenCode Zen: liga/desliga os modelos "-free" do Zen (precisa de OPENCODE_API_KEY, criada sem cartão).
OPENCODE_ENABLED=true
OPENCODE_API_KEY=
# Vazio = endereço do catálogo models.dev (padrão do OpenCode)
OPENCODE_BASE_URL=
# OpenRouter (modelos ":free") e NVIDIA build.nvidia.com (API gratuita): opcionais
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Modelos cobertos pelo plano gratuito da SUA conta (vazio = GEMINI_MODEL / GROQ_MODEL)
GEMINI_FREE_MODELS=
GROQ_FREE_MODELS=
# Privacidade padrão das conversas: publico (pode usar gratuitos que treinam com dados) | pessoal | local.
# Documentos anexados sempre sobem para "pessoal" (só fontes sem treino ou sua GPU).
PRIVACY_DEFAULT=publico
# Fontes cujos planos gratuitos podem usar os dados para treino (ficam fora de "pessoal")
SOURCES_TRAINING_ON_DATA=opencode,openrouter,nvidia,gemini,ollama-cloud
# Quantos modelos tentar por mensagem antes de desistir
ORCHESTRATOR_MAX_ATTEMPTS=4
MODELS_CATALOG_URL=https://models.dev/api.json
MODELS_CATALOG_REFRESH_HOURS=24
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local (não precisa de API key). Liste os modelos com: ollama list
OLLAMA_BASE_URL=http://localhost:11434/v1
# Use um modelo com suporte a tool calling (qwen2.5, qwen3, llama3.1...)
OLLAMA_MODEL=qwen2.5:7b-instruct
# Inferência local é mais lenta: timeout próprio por chamada (ms)
OLLAMA_TIMEOUT_MS=300000
# Raciocínio estendido de modelos como qwen3/deepseek-r1 (true = bem mais lento)
OLLAMA_THINK=false
# Teto de tokens por resposta (evita geração infinita que trava o modelo no Ollama)
OLLAMA_MAX_TOKENS=4096

# ─── Agent Loop ──────────────────────────────────────────────
MAX_ITERATIONS=5
# Teto de rodadas aceito nas skills de refinamento (bloco loop: do SKILL.md)
REFINEMENT_MAX_ROUNDS=30

# ─── Memória (SQLite) ────────────────────────────────────────
DB_PATH=./data/agrominds.db
MEMORY_WINDOW_SIZE=20
MAX_MESSAGE_CHARS=100000

# ─── Diretórios ──────────────────────────────────────────────
SKILLS_DIR=./.agents/skills
TMP_DIR=./tmp
# Pasta onde as ferramentas de arquivo podem ler/escrever (sandbox)
WORKSPACE_DIR=./workspace

# ─── Documentos ──────────────────────────────────────────────
MAX_DOCUMENT_MB=20
MAX_DOCUMENT_CHARS=100000

# ─── Voz: STT (Whisper local) ────────────────────────────────
# http (recomendado): container faster-whisper na GPU (Speaches), sem Python nem ffmpeg no Windows:
#   docker run -d --gpus all -p 8890:8000 -v whisper-hf-cache:/home/ubuntu/.cache/huggingface/hub --name whisper-stt ghcr.io/speaches-ai/speaches:latest-cuda
#   curl -X POST http://localhost:8890/v1/models/deepdml/faster-whisper-large-v3-turbo-ct2   (baixa o modelo uma vez)
# openai-whisper (pip install openai-whisper) | whisper-cpp (whisper-cli): processo local
WHISPER_ENGINE=http
WHISPER_BASE_URL=http://localhost:8890/v1
# http: id do modelo no Speaches | openai-whisper: tiny|base|small|medium|large | whisper-cpp: caminho do .bin
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Executável (apenas openai-whisper / whisper-cpp)
WHISPER_BIN=whisper
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_MS=60000
# ffmpeg só é necessário para os motores openai-whisper/whisper-cpp
FFMPEG_BIN=ffmpeg

# ─── Voz: TTS ────────────────────────────────────────────────
# Motores em ordem de preferência: kokoro (local, GPU) | edge (nuvem Microsoft)
TTS_ENGINES=kokoro
# Tempo máximo por síntese; ao estourar, tenta o próximo motor e depois cai para texto
TTS_TIMEOUT_MS=25000

# Kokoro-FastAPI na GPU:
#   docker run -d --gpus all -p 8880:8880 --name kokoro-tts --restart unless-stopped ghcr.io/remsky/kokoro-fastapi-gpu:latest
KOKORO_BASE_URL=http://localhost:8880/v1
# Vozes pt-BR: pf_dora (feminina), pm_alex, pm_santa (masculinas)
KOKORO_VOICE=pf_dora
KOKORO_SPEED=1.0
# Código de idioma do Kokoro: p = português do Brasil
KOKORO_LANG=p

# Voz do Edge-TTS (se usado em TTS_ENGINES)
TTS_VOICE=pt-BR-ThalitaMultilingualNeural

# ─── Voz clonada (Chatterbox na GPU) ─────────────────────────
# Pasta das amostras de voz. Áudios enviados com /minhavoz são salvos aqui, e arquivos
# .wav/.mp3/.ogg colocados manualmente também viram vozes (nome do arquivo = nome da voz).
VOICE_CLONE_DIR=./data/voices
# Voz usada por /falar e pela skill voz-clonada quando nenhuma é informada
VOICE_CLONE_DEFAULT=minha-voz
# Chatterbox-TTS-Server (modelo multilíngue). Subir com docker compose na pasta do servidor:
#   cd ....Chatterbox-TTS-Server && docker compose up -d
CHATTERBOX_BASE_URL=http://localhost:8004
VOICE_CLONE_LANGUAGE=pt
VOICE_CLONE_TIMEOUT_MS=180000

# ─── Logs ────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
